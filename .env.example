# ============================================================================
# ImpactConnect - Environment Configuration
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=5000

# PostgreSQL Database Configuration
# When DATABASE_URL is provided, ImpactConnect automatically connects to PostgreSQL.
# If omitted or offline, the platform seamlessly uses the embedded persistent relational engine.
DATABASE_URL=postgresql://postgres:impactpassword@localhost:5432/impactconnect

# Individual PG variables (alternative to DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=impactpassword
PGDATABASE=impactconnect
